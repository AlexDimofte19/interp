{
    "files.exclude": {
        "**/__pycache__": true,
        "**/.cache": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "**/.ruff_cache": true,
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/.cache": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.ruff_cache": true,
    },
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "always",
            "source.organizeImports.ruff": "always"
        }
    },
    "ruff.path": [
        "uvx",
        "ruff"
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python-envs.defaultEnvManager": "ms-python.vscode-python-envs:uv",
    "python-envs.defaultPackageManager": "ms-python.vscode-python-envs:uv",
    "python-envs.pythonProjects": [
        {
            "path": "${workspaceFolder}",
            "envManager": "ms-python.vscode-python-envs:uv",
            "packageManager": "ms-python.vscode-python-envs:uv"
        }
    ]
}
